            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"5-summary\">5.  Summary</h2>\n<table>\n<thead>\n<tr>\n<th>Parameter</th>\n<th>MLE Estimator</th>\n<th>Unbiased Estimator</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><marimo-tex class=\"arithmatex\">||(\\mu||)</marimo-tex></td>\n<td><marimo-tex class=\"arithmatex\">||(\\bar{x} = \\frac{1}{n}\\sum x_i||)</marimo-tex></td>\n<td><marimo-tex class=\"arithmatex\">||(\\bar{x}||)</marimo-tex> (same)</td>\n</tr>\n<tr>\n<td><marimo-tex class=\"arithmatex\">||(\\sigma^2||)</marimo-tex></td>\n<td><marimo-tex class=\"arithmatex\">||(\\frac{1}{n}\\sum (x_i - \\bar{x})^2||)</marimo-tex></td>\n<td><marimo-tex class=\"arithmatex\">||(\\frac{1}{n-1}\\sum (x_i - \\bar{x})^2||)</marimo-tex></td>\n</tr>\n</tbody>\n</table></span>"
